/* ===========================================================
   SECCION 10 - PROCEDIMIENTO: INGRESAR UN LOTE
   =========================================================== */

CREATE OR ALTER PROCEDURE sp_IngresarLote
    @Codigo           NVARCHAR(40),
    @ProductoId       INT,
    @ProveedorId      INT,
    @Cantidad         INT,
    @CostoUnitario    DECIMAL(10,2),
    @FechaVencimiento DATE = NULL
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS (SELECT 1 FROM Lotes WHERE Codigo = @Codigo)
    BEGIN
        RAISERROR('El lote %s ya fue ingresado.', 16, 1, @Codigo);
        RETURN;
    END

    BEGIN TRY
        BEGIN TRANSACTION;

        INSERT INTO Lotes (Codigo, ProductoId, ProveedorId,
                           Cantidad, CostoUnitario, FechaVencimiento)
        VALUES (@Codigo, @ProductoId, @ProveedorId,
                @Cantidad, @CostoUnitario, @FechaVencimiento);

        DECLARE @LoteId INT = SCOPE_IDENTITY();

        INSERT INTO MovimientosInventario
               (ProductoId, LoteId, Tipo, Cantidad, Referencia)
        VALUES (@ProductoId, @LoteId, 'ENTRADA', @Cantidad, @Codigo);

        UPDATE Productos
        SET    Stock = Stock + @Cantidad
        WHERE  Id = @ProductoId;

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END
GO


/* ===========================================================
   SECCION 11 - PROCEDIMIENTO: CONFIRMAR UN PEDIDO
   =========================================================== */

CREATE OR ALTER PROCEDURE sp_ConfirmarPedido
    @CarritoId      INT,
    @DireccionEnvio NVARCHAR(200) = NULL,
    @PedidoId       INT OUTPUT
AS
BEGIN
    SET NOCOUNT ON;
    DECLARE @ClienteId INT;

    SELECT @ClienteId = ClienteId
    FROM   Carritos
    WHERE  Id = @CarritoId AND Estado = 'ABIERTO';

    IF @ClienteId IS NULL
    BEGIN
        RAISERROR('Carrito inexistente o ya procesado.', 16, 1);
        RETURN;
    END

    IF NOT EXISTS (SELECT 1 FROM CarritoItems
                   WHERE CarritoId = @CarritoId)
    BEGIN
        RAISERROR('El carrito esta vacio.', 16, 1);
        RETURN;
    END

    IF EXISTS (SELECT 1
               FROM   CarritoItems ci
               JOIN   Productos p ON p.Id = ci.ProductoId
               WHERE  ci.CarritoId = @CarritoId
                 AND  p.Stock < ci.Cantidad)
    BEGIN
        RAISERROR('Existencia insuficiente en el carrito.', 16, 1);
        RETURN;
    END

    BEGIN TRY
        BEGIN TRANSACTION;

        INSERT INTO Pedidos (ClienteId, DireccionEnvio)
        VALUES (@ClienteId, @DireccionEnvio);

        SET @PedidoId = SCOPE_IDENTITY();

        INSERT INTO PedidoDetalle
               (PedidoId, ProductoId, Cantidad, PrecioUnitario)
        SELECT @PedidoId, ci.ProductoId, ci.Cantidad, p.Precio
        FROM   CarritoItems ci
        JOIN   Productos p ON p.Id = ci.ProductoId
        WHERE  ci.CarritoId = @CarritoId;

        UPDATE p
        SET    p.Stock = p.Stock - ci.Cantidad
        FROM   Productos p
        JOIN   CarritoItems ci ON ci.ProductoId = p.Id
        WHERE  ci.CarritoId = @CarritoId;

        INSERT INTO MovimientosInventario
               (ProductoId, Tipo, Cantidad, Referencia)
        SELECT ci.ProductoId, 'SALIDA', ci.Cantidad,
               'PEDIDO-' + CAST(@PedidoId AS VARCHAR(10))
        FROM   CarritoItems ci
        WHERE  ci.CarritoId = @CarritoId;

        UPDATE Pedidos
        SET    Total = (SELECT SUM(Cantidad * PrecioUnitario)
                        FROM   PedidoDetalle
                        WHERE  PedidoId = @PedidoId)
        WHERE  Id = @PedidoId;

        UPDATE Carritos
        SET    Estado = 'CONVERTIDO'
        WHERE  Id = @CarritoId;

        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END
GO


/* ===========================================================
   SECCION 12 - VISTAS
   =========================================================== */

CREATE OR ALTER VIEW vw_Catalogo
AS
SELECT  p.Id,
        p.Sku,
        p.Nombre,
        p.Descripcion,
        p.Precio,
        p.Stock,
        c.Nombre AS Categoria,
        CASE WHEN p.Stock = 0 THEN 'AGOTADO'
             WHEN p.Stock < 5 THEN 'POCAS UNIDADES'
             ELSE 'DISPONIBLE' END AS Disponibilidad
FROM    Productos  p
JOIN    Categorias c ON c.Id = p.CategoriaId
WHERE   p.Activo = 1;
GO

CREATE OR ALTER VIEW vw_ControlExistencias
AS
SELECT  p.Id,
        p.Nombre,
        p.Stock AS StockGuardado,
        ISNULL(SUM(CASE WHEN m.Tipo = 'ENTRADA' THEN  m.Cantidad
                        WHEN m.Tipo = 'SALIDA'  THEN -m.Cantidad
                        ELSE m.Cantidad END), 0) AS StockCalculado
FROM    Productos p
LEFT JOIN MovimientosInventario m ON m.ProductoId = p.Id
GROUP BY p.Id, p.Nombre, p.Stock;
GO

