/* Base de datos usada en el proyecto, contiene las tablas, datos de inicio, views, y los store procedure que se utilizaran
*/
USE master;
GO
IF DB_ID('TiendaUTEC') IS NULL
    CREATE DATABASE TiendaUTEC;
GO

USE TiendaUTEC;
GO

USE master; 
GO 
BACKUP DATABASE TiendaUTEC 
TO DISK = 'C:\backup\TiendaUTEC_antes_practica7.bak' 
WITH INIT; 
GO
-- Vistas y procedimientos primero: quedan rotos si se borran
-- las tablas que tienen debajo.
DROP VIEW      IF EXISTS vw_Catalogo;
DROP VIEW      IF EXISTS vw_ControlExistencias;
DROP PROCEDURE IF EXISTS sp_IngresarLote;
DROP PROCEDURE IF EXISTS sp_ConfirmarPedido;
GO

-- El orden importa: primero las tablas hijas, al final las
-- tablas padre. Si lo invierte, las llaves foraneas impiden
-- el borrado.
DROP TABLE IF EXISTS PedidoDetalle;
DROP TABLE IF EXISTS Pedidos;
DROP TABLE IF EXISTS CarritoItems;
DROP TABLE IF EXISTS Carritos;
DROP TABLE IF EXISTS MovimientosInventario;
DROP TABLE IF EXISTS Lotes;
DROP TABLE IF EXISTS Proveedores;
DROP TABLE IF EXISTS Clientes;
DROP TABLE IF EXISTS Productos;
DROP TABLE IF EXISTS Categorias;
GO

-- La tabla Productos tal como venia de las practicas
-- anteriores: la categoria todavia es texto.
CREATE TABLE Productos
(
    Id        INT IDENTITY(1,1) PRIMARY KEY,
    Nombre    NVARCHAR(60)  NOT NULL,
    Precio    DECIMAL(10,2) NOT NULL,
    Stock     INT           NOT NULL DEFAULT 0,
    Categoria NVARCHAR(50)  NOT NULL
);
GO

