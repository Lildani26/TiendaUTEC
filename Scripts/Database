/* ===========================================================
   SECCION 1 - CATEGORIAS Y MIGRACION DE LA COLUMNA DE TEXTO
   =========================================================== */

USE TiendaUTEC;
GO

CREATE TABLE Categorias
(
    Id          INT IDENTITY(1,1) PRIMARY KEY,
    Nombre      NVARCHAR(50)  NOT NULL,
    Descripcion NVARCHAR(200) NULL,
    Activa      BIT           NOT NULL DEFAULT 1,
    CONSTRAINT UQ_Categorias_Nombre UNIQUE (Nombre)
);
GO

-- Las categorias salen de los datos que ya existen
INSERT INTO Categorias (Nombre)
SELECT DISTINCT Categoria
FROM   Productos
WHERE  Categoria IS NOT NULL;
GO

-- Columna nueva, primero admitiendo nulos
ALTER TABLE Productos ADD CategoriaId INT NULL;
GO

-- Se llena cruzando por el nombre
UPDATE p
SET    p.CategoriaId = c.Id
FROM   Productos  p
JOIN   Categorias c ON c.Nombre = p.Categoria;
GO

-- VERIFIQUE antes de seguir: no debe devolver filas
SELECT * FROM Productos WHERE CategoriaId IS NULL;
GO

-- Ahora si, obligatoria
ALTER TABLE Productos ALTER COLUMN CategoriaId INT NOT NULL;
GO

ALTER TABLE Productos
ADD CONSTRAINT FK_Productos_Categorias
    FOREIGN KEY (CategoriaId) REFERENCES Categorias(Id);
GO

-- Se elimina el texto repetido
ALTER TABLE Productos DROP COLUMN Categoria;
GO


/* ===========================================================
   SECCION 2 - PRODUCTOS: COLUMNAS NUEVAS Y RESTRICCIONES
   =========================================================== */

ALTER TABLE Productos ADD
    Descripcion   NVARCHAR(400) NULL,
    Sku           NVARCHAR(20)  NULL,
    Activo        BIT           NOT NULL DEFAULT 1,
    FechaCreacion DATETIME2     NOT NULL DEFAULT GETDATE();
GO

UPDATE Productos
SET    Sku = 'SKU-' + RIGHT('00000' + CAST(Id AS VARCHAR(5)), 5);
GO

ALTER TABLE Productos ALTER COLUMN Sku NVARCHAR(20) NOT NULL;
GO

ALTER TABLE Productos
ADD CONSTRAINT UQ_Productos_Sku UNIQUE (Sku);
GO

ALTER TABLE Productos
ADD CONSTRAINT CK_Productos_Precio CHECK (Precio >= 0),
    CONSTRAINT CK_Productos_Stock  CHECK (Stock  >= 0);
GO


/* ===========================================================
   SECCION 3 - PROVEEDORES
   =========================================================== */

CREATE TABLE Proveedores
(
    Id        INT IDENTITY(1,1) PRIMARY KEY,
    Nombre    NVARCHAR(80)  NOT NULL,
    Contacto  NVARCHAR(80)  NULL,
    Telefono  NVARCHAR(20)  NULL,
    Correo    NVARCHAR(120) NULL,
    Activo    BIT           NOT NULL DEFAULT 1,
    CONSTRAINT UQ_Proveedores_Nombre UNIQUE (Nombre)
);
GO


/* ===========================================================
   SECCION 4 - LOTES
   =========================================================== */

CREATE TABLE Lotes
(
    Id               INT IDENTITY(1,1) PRIMARY KEY,
    Codigo           NVARCHAR(40)  NOT NULL,
    ProductoId       INT           NOT NULL,
    ProveedorId      INT           NOT NULL,
    Cantidad         INT           NOT NULL,
    CostoUnitario    DECIMAL(10,2) NOT NULL,
    FechaIngreso     DATETIME2     NOT NULL DEFAULT GETDATE(),
    FechaVencimiento DATE          NULL,
    CONSTRAINT UQ_Lotes_Codigo   UNIQUE (Codigo),
    CONSTRAINT CK_Lotes_Cantidad CHECK (Cantidad > 0),
    CONSTRAINT CK_Lotes_Costo    CHECK (CostoUnitario >= 0),
    CONSTRAINT FK_Lotes_Productos
        FOREIGN KEY (ProductoId)  REFERENCES Productos(Id),
    CONSTRAINT FK_Lotes_Proveedores
        FOREIGN KEY (ProveedorId) REFERENCES Proveedores(Id)
);
GO


/* ===========================================================
   SECCION 5 - MOVIMIENTOS DE INVENTARIO (BITACORA)
   =========================================================== */

CREATE TABLE MovimientosInventario
(
    Id          INT IDENTITY(1,1) PRIMARY KEY,
    ProductoId  INT          NOT NULL,
    LoteId      INT          NULL,
    Tipo        NVARCHAR(10) NOT NULL,
    Cantidad    INT          NOT NULL,
    Fecha       DATETIME2    NOT NULL DEFAULT GETDATE(),
    Referencia  NVARCHAR(60) NULL,
    CONSTRAINT CK_Mov_Tipo
        CHECK (Tipo IN ('ENTRADA', 'SALIDA', 'AJUSTE')),
    CONSTRAINT CK_Mov_Cantidad CHECK (Cantidad <> 0),
    CONSTRAINT FK_Mov_Productos
        FOREIGN KEY (ProductoId) REFERENCES Productos(Id),
    CONSTRAINT FK_Mov_Lotes
        FOREIGN KEY (LoteId) REFERENCES Lotes(Id)
);
GO


/* ===========================================================
   SECCION 6 - CLIENTES
   =========================================================== */

CREATE TABLE Clientes
(
    Id            INT IDENTITY(1,1) PRIMARY KEY,
    Nombre        NVARCHAR(80)  NOT NULL,
    Apellido      NVARCHAR(80)  NOT NULL,
    Correo        NVARCHAR(120) NOT NULL,
    Telefono      NVARCHAR(20)  NULL,
    Direccion     NVARCHAR(200) NULL,
    FechaRegistro DATETIME2     NOT NULL DEFAULT GETDATE(),
    Activo        BIT           NOT NULL DEFAULT 1,
    CONSTRAINT UQ_Clientes_Correo UNIQUE (Correo),
    CONSTRAINT CK_Clientes_Correo CHECK (Correo LIKE '%_@_%._%')
);
GO


/* ===========================================================
   SECCION 7 - CARRITO
   =========================================================== */

CREATE TABLE Carritos
(
    Id            INT IDENTITY(1,1) PRIMARY KEY,
    ClienteId     INT          NOT NULL,
    FechaCreacion DATETIME2    NOT NULL DEFAULT GETDATE(),
    Estado        NVARCHAR(12) NOT NULL DEFAULT 'ABIERTO',
    CONSTRAINT CK_Carritos_Estado
        CHECK (Estado IN ('ABIERTO', 'CONVERTIDO', 'ABANDONADO')),
    CONSTRAINT FK_Carritos_Clientes
        FOREIGN KEY (ClienteId) REFERENCES Clientes(Id)
);
GO

CREATE TABLE CarritoItems
(
    CarritoId  INT NOT NULL,
    ProductoId INT NOT NULL,
    Cantidad   INT NOT NULL,
    CONSTRAINT PK_CarritoItems PRIMARY KEY (CarritoId, ProductoId),
    CONSTRAINT CK_CarritoItems_Cantidad CHECK (Cantidad > 0),
    CONSTRAINT FK_CarritoItems_Carritos
        FOREIGN KEY (CarritoId) REFERENCES Carritos(Id)
        ON DELETE CASCADE,
    CONSTRAINT FK_CarritoItems_Productos
        FOREIGN KEY (ProductoId) REFERENCES Productos(Id)
);
GO


/* ===========================================================
   SECCION 8 - PEDIDOS Y DETALLE
   =========================================================== */

CREATE TABLE Pedidos
(
    Id             INT IDENTITY(1,1) PRIMARY KEY,
    ClienteId      INT           NOT NULL,
    Fecha          DATETIME2     NOT NULL DEFAULT GETDATE(),
    Estado         NVARCHAR(12)  NOT NULL DEFAULT 'PENDIENTE',
    Total          DECIMAL(12,2) NOT NULL DEFAULT 0,
    DireccionEnvio NVARCHAR(200) NULL,
    CONSTRAINT CK_Pedidos_Estado
        CHECK (Estado IN ('PENDIENTE', 'PAGADO', 'ENVIADO',
                          'ENTREGADO', 'CANCELADO')),
    CONSTRAINT CK_Pedidos_Total CHECK (Total >= 0),
    CONSTRAINT FK_Pedidos_Clientes
        FOREIGN KEY (ClienteId) REFERENCES Clientes(Id)
);
GO

CREATE TABLE PedidoDetalle
(
    PedidoId       INT           NOT NULL,
    ProductoId     INT           NOT NULL,
    Cantidad       INT           NOT NULL,
    PrecioUnitario DECIMAL(10,2) NOT NULL,
    CONSTRAINT PK_PedidoDetalle PRIMARY KEY (PedidoId, ProductoId),
    CONSTRAINT CK_Detalle_Cantidad CHECK (Cantidad > 0),
    CONSTRAINT FK_Detalle_Pedidos
        FOREIGN KEY (PedidoId)   REFERENCES Pedidos(Id),
    CONSTRAINT FK_Detalle_Productos
        FOREIGN KEY (ProductoId) REFERENCES Productos(Id)
);
GO


