@model TiendaUTEC.Models.Producto

@{
    ViewData["Title"] = "Editar producto";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Editar producto</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">
        &larr; Volver al catálogo
    </a>
</div>

<div class="card shadow-sm" style="max-width: 600px;">
    <div class="card-body">

        <form asp-action="Editar" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"></div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- El Id viaja oculto en el formulario: se envía para que el
                 controlador sepa qué producto actualizar, pero no se muestra
                 ni se edita, ya que es la llave primaria del producto. -->
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Precio"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control" />
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Stock" class="form-label"></label>
                <input asp-for="Stock"
                       type="number"
                       min="0"
                       class="form-control" />
                <span asp-validation-for="Stock" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CategoriaId" class="form-label"></label>

                <select asp-for="CategoriaId"
                        asp-items="ViewBag.Categorias"
                        class="form-select">
                    <option value="">Seleccione una categoria</option>
                </select>

                <span asp-validation-for="CategoriaId" class="text-danger">
                </span>
            </div>

            <div class="mb-4">
                <label asp-for="Descripcion" class="form-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning">
                    Guardar cambios
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}